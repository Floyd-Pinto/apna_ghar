# RAG Pipeline - exclude env, cache, and data sources
# The CSV data in rag-pipeline/data/ IS committed (the AI assistant and `make import-data` need it);
# the FAISS index is rebuilt from it on first start
rag-pipeline/faiss_store/
rag-pipeline/.env
rag-pipeline/__pycache__/
rag-pipeline/**/__pycache__/
rag-pipeline/.pytest_cache/
rag-pipeline/notebooks/
blockchain/fabric-samples/

# Hyperledger Fabric samples are downloaded by blockchain/setup-fabric.sh
blockchain/fabric-samples/

