# Copy to .env (used by docker compose and `make`). Everything is optional for local use:
# without a key, that feature falls back to its local version.

# Django
SECRET_KEY=change-me-to-a-long-random-string
# Root admin, created on start (python manage.py ensure_admin)
ADMIN_EMAIL=admin@apnaghar.local
ADMIN_PASSWORD=Admin@12345

# Load your old cloud data (rag-pipeline/data/*.csv) on first Docker start instead of the demo seed.
# This is what the AI assistant's index is built from, so keep it on unless you want demo data.
IMPORT_CLOUD_EXPORT=true

# Phone testing: serve the frontend over HTTPS so the camera works on http://<laptop-ip>:8080
VITE_HTTPS=false

# AI chatbot: free key from https://console.groq.com (without it, answers are built from search results)
GROQ_API_KEY=

# Blockchain API (only if you run the Fabric network: make fabric)
BLOCKCHAIN_API_KEY=

# Optional cloud services - leave empty to use the local equivalents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PINATA_API_KEY=
PINATA_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
