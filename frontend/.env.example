# Copy to frontend/.env (only needed when running the frontend on its own)
# Unset: http://localhost:8000. Empty (VITE_API_BASE_URL=): use the Vite dev proxy. URL: a deployed backend.
VITE_API_BASE_URL=
# Where the dev proxy sends /api, /media and /ipfs
VITE_PROXY_TARGET=http://localhost:8000
VITE_IPFS_GATEWAY_TARGET=http://localhost:8081
# Serve over HTTPS so the phone camera works on the LAN
VITE_HTTPS=false
